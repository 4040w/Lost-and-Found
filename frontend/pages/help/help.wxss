.help-page {
  background-color: #FAF8F5;
  padding: 16px;
  min-height: 100vh;
}

/* 页面标题 */
.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 20px;
  text-align: center;
}

/* 帮助分类标签 */
.help-tab {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 15px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #8A8A8A;
  position: relative;
}

.tab-item.active {
  color: #A8D5C2;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 2px;
  background-color: #A8D5C2;
}

/* 帮助内容 */
.help-content {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.help-item {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid #FAF8F5;
}

.help-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.item-title {
  font-size: 15px;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 8px;
}

.item-content {
  font-size: 14px;
  color: #8A8A8A;
  line-height: 1.8;
}

/* 联系我们 */
.contact-us {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.contact-title {
  font-size: 15px;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 8px;
}

.contact-content {
  font-size: 14px;
  color: #8A8A8A;
  line-height: 1.8;
}
