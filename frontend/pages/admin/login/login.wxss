.login-container {
  padding: 40rpx 32rpx;
  background-color: #FAF8F5;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
  color: #2D2D2D;
}

.form-item {
  margin-bottom: 24rpx;
}

.input {
  background-color: #F5F5F5;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #2D2D2D;
}

.login-btn {
  background: #A8D5C2;
  color: #fff;
  border-radius: 100rpx;
  margin-top: 40rpx;
}
