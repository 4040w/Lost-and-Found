page {
  background-color: #FAFAFA;
}

.page {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* ── Header ── */
.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx 16rpx;
  background-color: #FAFAFA;
}

.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 26rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  background: transparent;
  border: none;
  height: 72rpx;
  line-height: 72rpx;
}

.search-placeholder {
  color: #BBB;
  font-size: 28rpx;
}

.chat-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-icon-glyph {
  font-size: 32rpx;
  line-height: 1;
}

.chat-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #FF3B30;
  border: 2rpx solid #FAFAFA;
}

/* ── Sub-header: segmented + filter ── */
.sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 28rpx;
}

.seg {
  display: inline-flex;
  background-color: #ECECEC;
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 4rpx;
}

.seg-item {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 999rpx;
  transition: background-color 0.15s;
}

.seg-item-active {
  background-color: #FFFFFF;
  color: #1C1C1E;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.filter-trigger {
  font-size: 24rpx;
  color: #888;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
}

.filter-trigger-on {
  color: #1C1C1E;
  font-weight: 500;
}

.filter-trigger-arrow {
  font-size: 18rpx;
  color: #999;
}

/* ── Feed ── */
.feed {
  padding: 0 32rpx;
}

/* ── Empty / loading ── */
.empty {
  padding: 200rpx 0 0;
  text-align: center;
}

.empty-emoji { font-size: 100rpx; }
.empty-title { font-size: 32rpx; color: #1C1C1E; margin-top: 24rpx; font-weight: 600; }
.empty-sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }

.loading {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 40rpx 0;
}

/* ── Bottom sheet ── */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 99;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 16rpx 32rpx 40rpx;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-open { transform: translateY(0); }

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background-color: #DDD;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EFEFEF;
}

.sheet-label {
  font-size: 28rpx;
  color: #1C1C1E;
}

.sheet-value {
  font-size: 28rpx;
  color: #999;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.sheet-btn-ghost {
  background-color: #F2F2F2;
  color: #666;
}

.sheet-btn-primary {
  background-color: #1C1C1E;
  color: #FFFFFF;
  font-weight: 500;
}
