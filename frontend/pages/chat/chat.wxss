page {
  background-color: #ECECEC;
  height: 100vh;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  overflow-y: scroll;
}

.empty-hint {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 80rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.mine { justify-content: flex-end; }
.msg-row.theirs { justify-content: flex-start; }

.bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}

.bubble-mine {
  background-color: #95EC69;
  color: #1C1C1E;
  border-top-right-radius: 4rpx;
}

.bubble-theirs {
  background-color: #FFFFFF;
  color: #1C1C1E;
  border-top-left-radius: 4rpx;
}

.bubble.pending { opacity: 0.6; }

.msg-img {
  width: 320rpx;
  border-radius: 8rpx;
  display: block;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #F7F7F7;
  border-top: 1rpx solid #DDD;
  padding-bottom: env(safe-area-inset-bottom);
}

.input {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
}

.send-btn {
  margin-left: 16rpx;
  background-color: #DDDDDD;
  color: #999;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}
.send-btn::after { border: none; }

.send-btn.active {
  background-color: #07C160;
  color: #FFFFFF;
}

.conn-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #FFE58F;
  color: #555;
  text-align: center;
  font-size: 24rpx;
  padding: 8rpx 0;
  z-index: 10;
}
