.claim-page {
  padding-bottom: 20px;
}

.claim-header {
  background-color: #FFFFFF;
  padding: 16px;
  margin: 16px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.item-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 5px;
  color: #2D2D2D;
}

.item-type {
  font-size: 12px;
  color: #8A8A8A;
}

.form-section {
  background-color: #FFFFFF;
  margin: 0 16px 16px;
  padding: 16px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.form-item label.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 2px;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.upload-item {
  position: relative;
  width: 80px;
  height: 80px;
}

.upload-item image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

.upload-add {
  width: 80px;
  height: 80px;
  border: 1px dashed #D4CAFE;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #FAF8F5;
}

.upload-add image {
  width: 30px;
  height: 30px;
  margin-bottom: 5px;
}

.upload-add text {
  font-size: 12px;
  color: #8A8A8A;
}

.submit-btn {
  margin: 0 16px;
  width: calc(100% - 32px);
  background-color: #A8D5C2;
  color: white;
  border-radius: 50px;
}
