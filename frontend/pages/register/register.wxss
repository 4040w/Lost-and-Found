.register-page {
  padding: 40rpx 32rpx;
  background-color: #FAF8F5;
  min-height: 100vh;
}

.register-box {
  margin-top: 60rpx;
}

.input-item {
  background: #F5F5F5;
  border-radius: 16rpx;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
  border: none;
}

.input {
  font-size: 30rpx;
  color: #2D2D2D;
}

.code-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.code-item .input {
  flex: 1;
}

.code-btn {
  font-size: 26rpx;
  color: #A8D5C2;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
}

.code-btn.disabled {
  color: #8A8A8A;
}

.register-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #A8D5C2;
  color: #fff;
  border-radius: 100rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  border: none;
}

.btn-disabled {
  background-color: #C8EAE0 !important;
}

.to-login {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #8A8A8A;
}
