.location-page {
  padding-bottom: 20px;
}

.campus-map {
  width: 100%;
  height: 300px;
}

.search-bar {
  padding: 12px 16px;
  background-color: #FFFFFF;
}

.search-bar input {
  padding: 10px 12px;
  background-color: #F5F5F5;
  border: none;
  border-radius: 8px;
}

.location-list {
  background-color: #FFFFFF;
  margin: 16px;
  padding: 0 16px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.location-item {
  padding: 12px 0;
  border-bottom: 1px solid #FAF8F5;
}

.location-item:last-child {
  border-bottom: none;
}

.location-item .name {
  font-weight: bold;
  color: #2D2D2D;
}

.location-item .area {
  font-size: 12px;
  color: #8A8A8A;
}

.range-select {
  background-color: #FFFFFF;
  margin: 16px;
  padding: 16px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.range-title {
  font-size: 14px;
  margin-bottom: 10px;
  color: #2D2D2D;
}

.range-item {
  padding: 8px 12px;
  background-color: #F5F5F5;
  border: none;
  border-radius: 8px;
  margin-bottom: 8px;
  color: #8A8A8A;
}

.range-item.active {
  background-color: #D4CAFE;
  color: #6B5FA8;
}

.confirm-btn {
  margin: 0 16px;
  width: calc(100% - 32px);
  background-color: #A8D5C2;
  color: white;
  border-radius: 50px;
}
