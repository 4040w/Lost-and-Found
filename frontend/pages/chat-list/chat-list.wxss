page {
  background-color: #F2F2F2;
  height: 100%;
}

.chat-list-page {
  min-height: 100vh;
}

/* ── Empty state ── */
.empty {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text { font-size: 32rpx; color: #555; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #999; }

/* ── Row wrapper (positioning context for hidden action layer) ── */
.row-wrap {
  position: relative;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #ECECEC;
  overflow: hidden;
}

/* Hidden action layer sits behind the movable row */
.row-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
}
.action-delete {
  flex: 1;
  background-color: #FF3B30;
  color: #FFFFFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* movable-area must match row height for hit-testing; width is set inline */
.row-area {
  height: 160rpx;
  background-color: transparent;
}

/* movable-view IS the row; width is set inline */
.row {
  height: 160rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background-color: #FFFFFF;
}

/* ── Avatar + unread badge ── */
.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #EEE;
}
.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #FF3B30;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #FFFFFF;
  box-sizing: border-box;
}

/* ── Meta block ── */
.meta {
  flex: 1;
  min-width: 0;
}
.line-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.name {
  font-size: 32rpx;
  color: #1C1C1E;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}
.time {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.item-label {
  font-size: 22rpx;
  color: #07C160;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.last-msg {
  font-size: 26rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
