.my-claim-page {
  background-color: #FAF8F5;
  min-height: 100vh;
  padding: 16px;
}

/* 状态筛选标签 */
.status-tab {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #8A8A8A;
  position: relative;
}

.tab-item.active {
  color: #A8D5C2;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 2px;
  background-color: #A8D5C2;
}

/* 认领列表 */
.claim-list {
  margin-bottom: 20px;
}

.claim-item {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.claim-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.claim-actions {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #F0F0F0;
  display: flex;
  justify-content: flex-end;
}

.cancel-btn {
  font-size: 13px;
  color: #ff4d4f;
  border: 1px solid #ff4d4f;
  border-radius: 50px;
  padding: 5px 14px;
}

/* 物品信息 */
.item-info {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.item-info image,
.item-img-placeholder {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  flex-shrink: 0;
}

.item-img-placeholder {
  background-color: #F4F4F4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.info-content {
  flex: 1;
  overflow: hidden;
}

.item-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #2D2D2D;
}

.item-type {
  font-size: 12px;
  color: #8A8A8A;
  margin-bottom: 4px;
}

.apply-time {
  font-size: 11px;
  color: #8A8A8A;
}

/* 申请状态 */
.apply-status {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 50px;
  flex-shrink: 0;
}

.apply-status.pending {
  background-color: #FFF7E6;
  color: #E8A020;
}

.apply-status.agree {
  background-color: #EEF6F2;
  color: #3DAA72;
}

.apply-status.reject {
  background-color: #FFF2F0;
  color: #ff4d4f;
}
