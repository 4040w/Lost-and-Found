.found-publish-page {
  padding-bottom: 20px;
}

/* 步骤内容通用样式 */
.step-content {
  background-color: #FFFFFF;
  margin: 16px;
  padding: 16px;
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

/* 地点列表样式 */
.location-tips, .upload-tips, .confirm-tips {
  font-size: 12px;
  color: #8A8A8A;
  margin-bottom: 15px;
  line-height: 1.5;
}

.location-list {
  margin-bottom: 20px;
}

.location-item {
  background-color: #FAF8F5;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 10px;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 5px;
}

.item-header text:first-child {
  font-size: 12px;
  background-color: #D4CAFE;
  color: #6B5FA8;
  padding: 2px 8px;
  border-radius: 50px;
}

.item-name {
  font-weight: bold;
  color: #2D2D2D;
}

.item-range {
  font-size: 12px;
  color: #8A8A8A;
  margin-bottom: 8px;
}

.item-op {
  display: flex;
  gap: 10px;
  font-size: 12px;
}

.item-op view {
  color: #A8D5C2;
}

.del-btn {
  color: #ff4d4f !important;
}

.add-location-btn {
  width: 100%;
  padding: 10px;
  margin-bottom: 10px;
  background-color: #A8D5C2;
  color: white;
  border-radius: 50px;
}

/* 上传照片样式 */
.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.upload-item {
  position: relative;
  width: 80px;
  height: 80px;
}

.upload-item image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

.upload-add {
  width: 80px;
  height: 80px;
  border: 1px dashed #D4CAFE;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #FAF8F5;
}

.upload-add image {
  width: 30px;
  height: 30px;
  margin-bottom: 5px;
}

.upload-add text {
  font-size: 12px;
  color: #8A8A8A;
}

/* 信息确认样式 */
.confirm-info {
  margin-top: 15px;
}

.info-item {
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid #FAF8F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item label {
  font-size: 14px;
  color: #8A8A8A;
  display: block;
  margin-bottom: 5px;
}

.info-item text {
  font-size: 14px;
  color: #2D2D2D;
}

.location-info {
  margin-top: 5px;
}

.location-info view {
  font-size: 14px;
  color: #2D2D2D;
  margin-bottom: 3px;
}

/* 承诺复选框 */
.commit-checkbox {
  margin: 20px 0;
}

.commit-label {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  color: #8A8A8A;
  line-height: 1.5;
}

/* 步骤底部按钮行：上一步 + 下一步/确认发布 */
.step-btn-group {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.step-btn-group button {
  flex: 1;
  margin: 0;
}
