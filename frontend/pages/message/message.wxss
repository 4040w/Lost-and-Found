.message-page {
  background-color: #FAF8F5;
  padding-bottom: 20px;
}

/* 页面标题栏 */
.page-header {
  background-color: #FFFFFF;
  padding: 15px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #FAF8F5;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #2D2D2D;
}

.mark-btn {
  font-size: 14px;
  color: #A8D5C2;
  background-color: transparent;
  padding: 0;
}

/* 消息分类标签 */
.message-tab {
  display: flex;
  background-color: #FFFFFF;
  padding: 0 16px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 14px;
  color: #8A8A8A;
  position: relative;
}

.tab-item.active {
  color: #A8D5C2;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 2px;
  background-color: #A8D5C2;
}

/* 未读徽章 */
.badge {
  position: absolute;
  top: 5px;
  right: 30%;
  background-color: #ff4d4f;
  color: white;
  font-size: 10px;
  padding: 1px 4px;
  border-radius: 10px;
  min-width: 16px;
  text-align: center;
}

/* 消息列表 */
.message-list {
  margin: 12px 16px;
}

.message-item {
  background-color: #FFFFFF;
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 12px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

/* 未读消息样式 */
.message-item.unread {
  border-left: 3px solid #A8D5C2;
  background-color: #F0FAF6;
}

/* 消息图标 */
.msg-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 18px;
  flex-shrink: 0;
}

.msg-icon.system {
  background-color: #EEF6F2;
  color: #5BAF8A;
}

.msg-icon.claim {
  background-color: #EEF0FF;
  color: #9B8FDB;
}

/* 消息内容 */
.msg-content {
  flex: 1;
  overflow: hidden;
}

.msg-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #2D2D2D;
}

.msg-desc {
  font-size: 13px;
  color: #8A8A8A;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.msg-time {
  font-size: 11px;
  color: #8A8A8A;
}

/* 未读标记 */
.unread-dot {
  width: 8px;
  height: 8px;
  background-color: #A8D5C2;
  border-radius: 50%;
  margin-top: 8px;
}

/* 空数据提示 */
.empty {
  text-align: center;
  padding: 40px 0;
  color: #8A8A8A;
  font-size: 14px;
}
