page {
  background-color: #FFFFFF;
}

.page {
  padding-bottom: 200rpx;
}

/* ── Hero ── */
.hero {
  position: relative;
  width: 100%;
  height: 560rpx;
  background-color: #F4F4F4;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  color: #DDD;
}

.hero-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 260rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 100%);
}

.hero-overlay {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  color: #FFFFFF;
}

.hero-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.tag-lost {
  background-color: rgba(255, 240, 230, 0.95);
  color: #C56A17;
}

.tag-found {
  background-color: rgba(232, 248, 240, 0.95);
  color: #2B8B5A;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

.hero-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-meta-dot {
  margin: 0 8rpx;
}

/* ── Body sections — single surface, hairline dividers ── */
.body {
  background-color: #FFFFFF;
}

.sec {
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid #EFEFEF;
}

.sec:last-child {
  border-bottom: none;
}

.sec-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
}

.sec-content {
  font-size: 30rpx;
  color: #1C1C1E;
  line-height: 1.6;
}

.sec-muted {
  color: #BBB;
  font-size: 28rpx;
}

.sec-muted-inline {
  color: #999;
  font-size: 26rpx;
  margin-left: 12rpx;
}

.sec-reward {
  font-size: 38rpx;
  font-weight: 600;
  color: #E8862A;
}

/* Numbered location list */
.sec-list-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.sec-list-idx {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #F2F2F2;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.sec-list-text {
  flex: 1;
  min-width: 0;
}

.sec-list-name {
  font-size: 30rpx;
  color: #1C1C1E;
  font-weight: 500;
}

.sec-list-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.body-foot {
  height: 40rpx;
}

/* ── Sticky bottom action ── */
.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #EFEFEF;
  box-sizing: border-box;
}

.action-primary {
  flex: 1;
  height: 92rpx;
  background-color: #1C1C1E;
  color: #FFFFFF;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.action-primary-glyph {
  font-size: 30rpx;
  line-height: 1;
}

.action-more {
  flex-shrink: 0;
  height: 92rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F2F2F2;
  color: #1C1C1E;
  border-radius: 999rpx;
  font-size: 28rpx;
}
