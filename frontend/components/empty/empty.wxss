.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  color: #8A8A8A;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-text {
  font-size: 14px;
  margin-bottom: 8px;
}

.empty-subtext {
  font-size: 12px;
  margin-bottom: 20px;
  line-height: 1.5;
  text-align: center;
}

.empty-btn {
  font-size: 14px;
  padding: 8px 24px;
  background-color: #A8D5C2;
  color: white;
  border-radius: 50px;
}
