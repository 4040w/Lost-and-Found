.map-select {
  width: 100%;
  height: 400px;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.search-bar {
  position: absolute;
  top: 10px;
  left: 10px;
  right: 10px;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 0 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.search-bar input {
  width: 100%;
  height: 36px;
  font-size: 14px;
}

.search-result {
  position: absolute;
  top: 56px;
  left: 10px;
  right: 10px;
  background-color: #FFFFFF;
  border-radius: 8px;
  max-height: 150px;
  overflow-y: auto;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.result-item {
  padding: 10px 12px;
  border-bottom: 1px solid #FAF8F5;
  font-size: 14px;
  color: #2D2D2D;
}

.range-select {
  position: absolute;
  bottom: 60px;
  left: 10px;
  right: 10px;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 10px;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.range-item {
  padding: 6px 12px;
  font-size: 12px;
  background-color: #F5F5F5;
  border: none;
  border-radius: 50px;
  color: #8A8A8A;
}

.range-item.active {
  background-color: #D4CAFE;
  color: #6B5FA8;
}

.confirm-btn {
  position: absolute;
  bottom: 10px;
  left: 10px;
  right: 10px;
  background-color: #A8D5C2;
  color: white;
  border-radius: 50px;
}
